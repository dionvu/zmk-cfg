#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            require-prior-idle-ms = <150>;
            timeout-ms = <50>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <14 15>;
            require-prior-idle-ms = <150>;
            timeout-ms = <50>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <6 7>;
            require-prior-idle-ms = <150>;
            timeout-ms = <50>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <4 3>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <3 2>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        asterik {
            bindings = <&kp ASTERISK>;
            key-positions = <26 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <21 20>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <19 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        LParLT {
            bindings = <&LParLT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        RParGT {
            bindings = <&RParGT>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        LBrackets {
            bindings = <&LBrackets>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        RBrackets {
            bindings = <&RBrackets>;
            key-positions = <33 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <4 5>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <29 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <28 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <16 15>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        hashtag {
            bindings = <&kp POUND>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <31 30>;
        };
    };

    behaviors {
        HRLeft: HRLeft {
            compatible = "zmk,behavior-hold-tap";
            label = "HRLEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <39 40 41 30 18 6 7 19 31 32 20 8 9 10 11 21 22 23 33 34 35>;
            hold-trigger-on-release;
        };

        HRRight: HRRight {
            compatible = "zmk,behavior-hold-tap";
            label = "HRRIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        LParLT: LParLT {
            compatible = "zmk,behavior-mod-morph";
            label = "LPARLT";
            bindings = <&kp LPAR>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RParGT: RParGT {
            compatible = "zmk,behavior-mod-morph";
            label = "RPARGT";
            bindings = <&kp RPAR>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        LBrackets: LBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRACKETS";
            bindings = <&kp LEFT_BRACE>, <&kp LEFT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RBrackets: RBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "RBRACKETS";
            bindings = <&kp RIGHT_BRACE>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        FuncLayerR: FuncLayerR {
            compatible = "zmk,behavior-hold-tap";
            label = "FUNCLAYERR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        FuncLayerL: FuncLayerL {
            compatible = "zmk,behavior-hold-tap";
            label = "FUNCLAYERL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <39 40 41 30 18 6 7 19 31 32 20 8 9 10 11 21 22 23 33 34 35>;
            hold-trigger-on-release;
        };

        MMcommaSemi: MMcommaSemi {
            compatible = "zmk,behavior-mod-morph";
            label = "MMCOMMASEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        MMPeriodColon: MMPeriodColon {
            compatible = "zmk,behavior-mod-morph";
            label = "MMPERIODCOLON";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        MMExclamQuest: MMExclamQuest {
            compatible = "zmk,behavior-mod-morph";
            label = "MMEXCLAMQUEST";
            bindings = <&kp EXCL>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        MMQuotes: MMQuotes {
            compatible = "zmk,behavior-mod-morph";
            label = "MMQUOTES";
            bindings = <&kp DOUBLE_QUOTES>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        LongPress: LongPress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        TDCommaSemic: TDCommaSemic {
            compatible = "zmk,behavior-tap-dance";
            label = "TDCOMMASEMIC";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            tapping-term-ms = <350>;
        };

        TDEclaimationQuestion: TDEclaimationQuestion {
            compatible = "zmk,behavior-tap-dance";
            label = "TDECLAIMATIONQUESTION";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION>, <&kp RS(QUESTION)>;

            tapping-term-ms = <350>;
        };

        TDPeriodColon: TDPeriodColon {
            compatible = "zmk,behavior-tap-dance";
            label = "TDPERIODCOLON";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp COLON>;

            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp GRAVE  &kp Q               &kp W               &kp E                 &kp R                   &LongPress LC(T) T    &LongPress LC(Y) Y   &kp U             &kp I                    &kp O             &MMQuotes               &kp BACKSLASH
&trans     &HRLeft LEFT_ALT A  &HRLeft LEFT_WIN S  &HRLeft LEFT_SHIFT D  &HRLeft LEFT_CONTROL F  &kp G                 &kp H                &HRRight RCTRL J  &HRRight LEFT_SHIFT K    &HRRight RMETA L  &HRRight RIGHT_ALT P    &trans
&trans     &LongPress LC(Z) Z  &LongPress LC(X) X  &LongPress LC(C) C    &LongPress LC(V) V      &kp B                 &kp N                &kp M             &TDCommaSemic            &TDPeriodColon    &TDEclaimationQuestion  &trans
                                                   &FuncLayerL 3 ESCAPE  &FuncLayerL 2 SPACE     &FuncLayerL 4 TAB     &FuncLayerR 1 ENTER  &sk RIGHT_SHIFT   &FuncLayerR 3 BACKSPACE
            >;
        };

        num {
            bindings = <
&trans  &trans        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp N7        &kp N8        &kp N9        &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans     &trans          &trans     &trans    &trans    &trans    &trans        &trans     &trans  &trans
&trans  &kp LALT  &kp LMETA  &kp LEFT_SHIFT  &kp LCTRL  &trans    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans    &trans     &trans          &trans     &trans    &trans    &trans    &trans        &trans     &trans  &trans
                             &trans          &trans     &trans    &trans    &trans    &trans
            >;
        };

        fun {
            bindings = <
&bt BT_SEL 0  &trans  &kp F4  &kp F5  &kp F6  &kp F10    &trans           &trans        &trans           &trans      &trans  &trans
&bt BT_SEL 1  &trans  &kp F1  &kp F2  &kp F3  &kp F11    &kp K_PREV       &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_NEXT  &trans  &bt BT_CLR
&bt BT_SEL 2  &trans  &kp F7  &kp F8  &kp F9  &kp F12    &kp PRINTSCREEN  &trans        &trans           &trans      &trans  &trans
                              &trans  &trans  &trans     &trans           &trans        &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK       &trans          &trans
            >;
        };
    };
};
