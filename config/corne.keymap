#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        EscJK {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <18 30>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <6 18>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <19 31>;
        };

        asterik {
            bindings = <&kp ASTERISK>;
            key-positions = <20 8>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <20 32>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <9 21>;
        };

        vbar {
            bindings = <&kp PIPE>;
            key-positions = <22 34>;
        };
    };

    behaviors {
        TDComPer: TDComPer {
            compatible = "zmk,behavior-tap-dance";
            label = "TDCOMPER";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp PERIOD>;
        };

        TDLTGT: TDLTGT {
            compatible = "zmk,behavior-tap-dance";
            label = "TDLTGT";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
        };

        TDquotes: TDquotes {
            compatible = "zmk,behavior-tap-dance";
            label = "TDQUOTES";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        TDGraveTil: TDGraveTil {
            compatible = "zmk,behavior-tap-dance";
            label = "TDGRAVETIL";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
        };

        TDMinusUnd: TDMinusUnd {
            compatible = "zmk,behavior-tap-dance";
            label = "TDMINUSUND";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };

        TDPlusEq: TDPlusEq {
            compatible = "zmk,behavior-tap-dance";
            label = "TDPLUSEQ";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp PLUS>;
        };

        BetterWin: BetterWin {
            compatible = "zmk,behavior-tap-dance";
            label = "BETTERWIN";
            #binding-cells = <0>;
            bindings = <&sk LEFT_WIN>, <&kp LEFT_WIN>;
        };

        TDExplamQuest: TDExplamQuest {
            compatible = "zmk,behavior-tap-dance";
            label = "TDEXPLAMQUEST";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp QUESTION>;
        };

        HRLeft: HRLeft {
            compatible = "zmk,behavior-hold-tap";
            label = "HRLEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <39 40 41 30 18 6 7 19 31 32 20 8 9 10 11 21 22 23 33 34 35>;
            hold-trigger-on-release;
        };

        HRRight: HRRight {
            compatible = "zmk,behavior-hold-tap";
            label = "HRRIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            bindings = <
&kp TAB        &kp Q                &kp W               &kp E                 &kp R                   &kp T    &kp Y  &kp U             &kp I                  &kp O            &kp P                     &kp BACKSPACE
&kp BACKSPACE  &HRLeft LEFT_META A  &HRLeft LEFT_ALT S  &HRLeft LEFT_SHIFT D  &HRLeft LEFT_CONTROL F  &kp G    &kp H  &HRRight RCTRL J  &HRRight LEFT_SHIFT K  &HRRight RALT L  &HRRight SEMI RIGHT_META  &kp ENTER
&sk LCTRL      &kp Z                &kp X               &kp C                 &kp V                   &kp B    &kp N  &kp M             &TDComPer              &TDLTGT          &sk RCTRL                 &sk SLASH
                                                        &BetterWin            &kp SPACE               &mo 1    &sl 1  &sk RIGHT_SHIFT   &sl 2
            >;
        };

        lower_layer {
            bindings = <
&TDGraveTil  &TDExplamQuest  &kp AT_SIGN   &kp POUND     &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans       &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0           &trans
&trans       &trans          &kp TILDE     &kp GRAVE     &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &TDMinusUnd   &TDPlusEq             &trans                 &trans
                                           &kp LEFT_WIN  &sk LEFT_SHIFT    &trans            &trans           &sk RIGHT_SHIFT    &trans
            >;
        };

        function_layer {
            bindings = <
&trans      &kp F6        &kp F7        &kp F8        &kp F9   &kp F10    &kp K_PREV      &kp K_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_NEXT  &kp K_MUTE  &trans
&trans      &kp F1        &kp F2        &kp F3        &kp F4   &kp F5     &kp LEFT_ARROW  &kp DOWN           &kp UP_ARROW     &kp RIGHT   &trans      &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp F11  &kp F12    &trans          &trans             &trans           &trans      &trans      &kp PRINTSCREEN
                                        &trans        &trans   &trans     &trans          &trans             &trans
            >;
        };
    };
};
