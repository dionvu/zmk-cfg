#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        percent {
            bindings = <&LBrackets>;
            key-positions = <14 15>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        dollar {
            bindings = <&RBrackets>;
            key-positions = <16 15>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <4 3>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        hashtag {
            bindings = <&kp UNDER>;
            key-positions = <2 3>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        pipe {
            bindings = <&kp PLUS>;
            key-positions = <4 16>;
        };

        grave {
            bindings = <&kp MINUS>;
            key-positions = <3 15>;
        };

        pipetuah {
            bindings = <&kp DOLLAR>;
            key-positions = <27 26>;
        };

        endofgodlike {
            bindings = <&kp HASH>;
            key-positions = <28 27>;
        };

        endofgodlike4 {
            bindings = <&kp ASTERISK>;
            key-positions = <5 17>;
        };

        plus {
            bindings = <&kp AT>;
            key-positions = <20 8>;
        };

        minus {
            bindings = <&LParLT>;
            key-positions = <20 19>;
        };

        atsym {
            bindings = <&RParGT>;
            key-positions = <21 20>;
        };

        mult {
            bindings = <&kp AMPS>;
            key-positions = <19 7>;
        };

        colon {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        semi {
            bindings = <&kp COLON>;
            key-positions = <9 8>;
        };

        caettt {
            bindings = <&kp CARET>;
            key-positions = <6 18>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <31 32>;
        };

        sc {
            bindings = <&kp SEMI>;
            key-positions = <32 33>;
        };

        startforgottenones {
            bindings = <&kp GRAVE>;
            key-positions = <1 13>;
        };

        forgotten2 {
            bindings = <&kp PERCENT>;
            key-positions = <2 14>;
        };

        forgotten3 {
            bindings = <&kp BACKSLASH>;
            key-positions = <10 22>;
        };
    };

    behaviors {
        HRLeft: HRLeft {
            compatible = "zmk,behavior-hold-tap";
            label = "HRLEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <39 40 41 30 18 6 7 19 31 32 20 8 9 10 11 21 22 23 33 34 35>;
            hold-trigger-on-release;
        };

        HRRight: HRRight {
            compatible = "zmk,behavior-hold-tap";
            label = "HRRIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        LParLT: LParLT {
            compatible = "zmk,behavior-mod-morph";
            label = "LPARLT";
            bindings = <&kp LPAR>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RParGT: RParGT {
            compatible = "zmk,behavior-mod-morph";
            label = "RPARGT";
            bindings = <&kp RPAR>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        LBrackets: LBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRACKETS";
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RBrackets: RBrackets {
            compatible = "zmk,behavior-mod-morph";
            label = "RBRACKETS";
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        FuncLayerR: FuncLayerR {
            compatible = "zmk,behavior-hold-tap";
            label = "FUNCLAYERR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        FuncLayerL: FuncLayerL {
            compatible = "zmk,behavior-hold-tap";
            label = "FUNCLAYERL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <39 40 41 30 18 6 7 19 31 32 20 8 9 10 11 21 22 23 33 34 35>;
            hold-trigger-on-release;
        };

        LongPress: LongPress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        TDEclaimationQuestion: TDEclaimationQuestion {
            compatible = "zmk,behavior-tap-dance";
            label = "TDECLAIMATIONQUESTION";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION>, <&kp RS(QUESTION)>;

            tapping-term-ms = <200>;
        };

        TDQuotes: TDQuotes {
            compatible = "zmk,behavior-tap-dance";
            label = "TDQUOTES";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;

            tapping-term-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&trans  &kp Q               &kp W               &kp E                 &kp R                   &LongPress LC(T) T    &LongPress LC(Y) Y   &kp U             &kp I                    &kp O             &TDQuotes               &trans
&trans  &HRLeft LEFT_ALT A  &HRLeft LEFT_WIN S  &HRLeft LEFT_SHIFT D  &HRLeft LEFT_CONTROL F  &kp G                 &kp H                &HRRight RCTRL J  &HRRight LEFT_SHIFT K    &HRRight RMETA L  &HRRight RIGHT_ALT P    &trans
&trans  &LongPress LC(Z) Z  &LongPress LC(X) X  &LongPress LC(C) C    &LongPress LC(V) V      &kp B                 &kp N                &kp M             &kp COMMA                &kp PERIOD        &TDEclaimationQuestion  &trans
                                                &FuncLayerL 3 ESCAPE  &FuncLayerL 2 SPACE     &FuncLayerL 4 TAB     &FuncLayerR 1 ENTER  &sk RIGHT_SHIFT   &FuncLayerR 3 BACKSPACE
            >;
        };

        num {
            bindings = <
&trans  &trans        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp N7        &kp N8        &kp N9        &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans     &trans          &trans     &trans    &trans    &trans    &trans        &trans     &trans  &trans
&trans  &kp LALT  &kp LMETA  &kp LEFT_SHIFT  &kp LCTRL  &trans    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans    &trans     &trans          &trans     &trans    &trans    &trans    &trans        &trans     &trans  &trans
                             &trans          &trans     &trans    &trans    &trans    &trans
            >;
        };

        fun {
            bindings = <
&bt BT_SEL 0  &trans  &kp F4  &kp F5  &kp F6  &kp F10    &trans           &trans        &trans           &trans      &trans  &trans
&bt BT_SEL 1  &trans  &kp F1  &kp F2  &kp F3  &kp F11    &kp K_PREV       &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_NEXT  &trans  &bt BT_CLR
&bt BT_SEL 2  &trans  &kp F7  &kp F8  &kp F9  &kp F12    &kp PRINTSCREEN  &trans        &trans           &trans      &trans  &trans
                              &trans  &trans  &trans     &trans           &trans        &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK       &trans          &trans
            >;
        };
    };
};
